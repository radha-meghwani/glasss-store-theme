<div class="badges-section">
        <div class="main">
        {% if section.settings.main_heading != blank %}
            <h2>{{ section.settings.main_heading }}</h2>
        {% endif %}

        {% if section.settings.sub_heading != blank %}
            <p>{{ section.settings.sub_heading }}</p>
        {% endif %}
        </div>

        <div class="main-container">

  {% for block in section.blocks %}

  <div class="badges">  

     <div class="bdge">
      {% if block.settings.badge_image != blank %}
        <img class="badge-image"
          src="{{ block.settings.badge_image | img_url: 'master' }}"
          alt="badge image">
      {% endif %}
    </div>

    <div class="bdge-text">
      {% if block.settings.badge_heading != blank %}
        <h2>{{ block.settings.badge_heading }}</h2>
      {% endif %}

      {% if block.settings.badge_subheading != blank %}
        <p>{{ block.settings.badge_subheading }}</p>
      {% endif %}
      </div>

  </div>

  {% endfor %}

        </div>

</div>

<style>

  .slick-dots {
    bottom: -30px!important;
}

  .badges {
    display: flex!important;
    {% comment %} background-color: #ffe4c4; {% endcomment %}
    align-items: center;
    flex-direction: column;
    justify-content: center;
    align-content: center;
    flex-wrap: wrap;
    padding-bottom: 60px;
}

.bdge-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0px;
}

    .main{
        display:flex;
        flex-direction: column;
        align-items: center;
        padding: 30px;
        padding-bottom: 20px;
    }

    .main {
    display: flex;
    flex-direction: column;
    align-items: center;
    }

    .main h2 {
    font-size: 33px;
    line-height: normal;
    letter-spacing: normal;
    font-weight: 700;
    text-align: center;
    margin: 0px 0px 8px;

    }

    .main p {
    max-width: 62%;
    margin: auto;
    text-align: center;
    color: #6a6a6a;
    font-size: 16px;ss
    font-weight: 500;
    letter-spacing: normal;
    }

.badges-section{
   background-color:#faf0e4;
   padding: 50px;
}

.badges:hover{
  cursor:pointer;
}

img.badge-image {
    height: 93px;
    width: 83px;
}

.main-container {
    {% comment %} margin: auto; {% endcomment %}
    justify-content: center;
    align-items: center;
    {% comment %} gap: 10px;
    padding: 15px; {% endcomment %}
    {% comment %} gap: 20px;
    padding: 30px; {% endcomment %}
    margin:20px;
}
.bdge-text h2 {
    font-size: 23px;
    line-height: 24px;
    font-weight: 700;
    color: #0a214f;
    text-align: left;
    letter-spacing: 0px;
    margin:0px;
    margin-top:20px;
}

.bdge-text h2:hover{
  color:#ebbaa9;
  cursor:pointer;
}
.bdge-text p {
    font-size: 16px;
    line-height: 25px;
    font-weight: 500;
    letter-spacing: 0px;
    color: #0a214f;
    text-align: center;
    margin: 0px;
}

@media(max-width:427px){
  .main p {
    max-width: 100%;
    font-size: 15px;
}

.slick-prev:before, .slick-next:before {
    color: #c46949!important;
}

 .badges{
  padding-bottom:10px;
}

}

</style>

<!-- jQuery MUST load first -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Slick CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css" />

<!-- Slick JS -->
<script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>

<script>
$('.main-container').slick({
  dots: true,
  infinite: false,
  speed: 300,
  slidesToShow: 3,
  slidesToScroll: 3,
  responsive: [
    {
      breakpoint: 1024,
      settings: {
        slidesToShow: 2,
        slidesToScroll: 2,
        infinite: true,
        dots: true
      }
    },
    {
      breakpoint: 600,
      settings: {
        slidesToShow: 2,
        slidesToScroll: 2
      }
    },
    {
      breakpoint: 480,
      settings: {
        slidesToShow: 1,
        slidesToScroll: 1
      }
    }
    // You can unslick at a given breakpoint now by adding:
    // settings: "unslick"
    // instead of a settings object
  ]
});
</script> 

{% schema %}
{
    "name": "custom-badges",
    "settings": [
        {
            "type": "text",
            "id": "main_heading",
            "label": "main-heading"
        },
        {
            "type": "text",
            "id": "sub_heading",
            "label": "main-heading"
        }
    ],
    "blocks":[
        {
            "type": "badges_block",
            "name":"badges block",
            "settings": [
        {
            "type": "image_picker",
            "id": "badge_image",
            "label": "badge image"
        },
        {
            "type": "text",
            "id": "badge_heading",
            "label": "badge heading",
            "default":"badge heading"
        },
        {
            "type":"text",
            "id": "badge_subheading",
            "label": "badge subheading",
            "default": "badge subheading"
      }
      ]
    }
  ],
  "presets": [
    {
      "name": "custom-badges",
      "category": "Custom",
      "blocks": [
        { "type": "badges_block" },
        { "type": "badges_block" },
        { "type": "badges_block" }
      ]
    }
  ]
}
{% endschema %}
