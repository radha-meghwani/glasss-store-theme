{% stylesheet %}
  .map-locator-v2-section {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    position: relative;
  }

  .map-locator-v2-container {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    align-items: center;
    max-width: 1400px;
    margin: 0 auto;
    gap: 2rem;
    position: relative;
    z-index: 1;
  }

  .map-locator-v2-content {
    padding: 0 2rem;
    color: {{ section.settings.text_color }};
    z-index: 10;
    position: relative;
  }

  .map-locator-v2-content-small-heading {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    opacity: 0.7;
    margin-bottom: 1rem;
  }

  .map-locator-v2-content-heading {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: {{ section.settings.text_color }};
  }

  .map-locator-v2-content-description {
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    opacity: 0.85;
  }

  .map-locator-v2-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .map-locator-v2-stat {
    display: flex;
    flex-direction: column;
  }

  .map-locator-v2-stat-number {
    font-size: 2rem;
    font-weight: 700;
    color: {{ section.settings.text_color }};
    margin-bottom: 0.5rem;
  }

  .map-locator-v2-stat-label {
    font-size: 0.9rem;
    opacity: 0.7;
  }

  .map-locator-v2-globe-wrapper {
    position: relative;
    width: 100%;
    height: {{ section.settings.globe_size_desktop }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #map-locator-v2-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .map-locator-v2-modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    animation: fadeIn 0.3s ease-in-out;
  }

  .map-locator-v2-modal.active {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .map-locator-v2-modal-content {
    background: white;
    padding: 2rem;
    border-radius: 8px;
    max-width: 600px;
    width: 90%;
    max-height: 80vh;
    overflow-y: auto;
    animation: slideUp 0.3s ease-in-out;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  }

  .map-locator-v2-modal-close {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: #666;
    float: right;
    padding: 0;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .map-locator-v2-modal-close:hover {
    color: #000;
  }

  .map-locator-v2-modal-image {
    width: 100%;
    height: 300px;
    object-fit: cover;
    border-radius: 6px;
    margin-bottom: 1rem;
  }

  .map-locator-v2-modal-name {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: #000;
  }

  .map-locator-v2-modal-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    color: #666;
  }

  .map-locator-v2-modal-info {
    margin-bottom: 1.5rem;
  }

  .map-locator-v2-modal-info-row {
    display: flex;
    align-items: flex-start;
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .map-locator-v2-modal-info-label {
    font-weight: 600;
    min-width: 80px;
    color: #333;
  }

  .map-locator-v2-modal-info-value {
    color: #666;
    word-break: break-word;
  }

  .map-locator-v2-modal-description {
    line-height: 1.6;
    color: #555;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }

  .map-locator-v2-modal-button {
    display: inline-block;
    background-color: {{ section.settings.text_color }};
    color: {{ section.settings.background_color }};
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    transition: opacity 0.3s;
    border: none;
    cursor: pointer;
  }

  .map-locator-v2-modal-button:hover {
    opacity: 0.9;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slideUp {
    from {
      transform: translateY(30px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @media (max-width: 1024px) {
    .map-locator-v2-container {
      grid-template-columns: 1fr;
    }

    .map-locator-v2-globe-wrapper {
      height: {{ section.settings.globe_size_tablet }}px;
      margin-top: 2rem;
    }

    .map-locator-v2-content {
      padding: 0;
    }
  }

  @media (max-width: 768px) {
    .map-locator-v2-section {
      padding-top: {{ section.settings.padding_top | times: 0.5 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round }}px;
    }

    .map-locator-v2-content-heading {
      font-size: 1.75rem;
    }

    .map-locator-v2-stats {
      grid-template-columns: 1fr;
    }

    .map-locator-v2-globe-wrapper {
      height: {{ section.settings.globe_size_mobile }}px;
    }

    .map-locator-v2-modal-content {
      width: 95%;
      padding: 1.5rem;
    }
  }
{% endstylesheet %}

<div class="map-locator-v2-section">
  <div class="map-locator-v2-container">
    <div class="map-locator-v2-content">
      {% if section.settings.small_heading != blank %}
        <div class="map-locator-v2-content-small-heading">{{ section.settings.small_heading }}</div>
      {% endif %}

      {% if section.settings.main_heading != blank %}
        <h2 class="map-locator-v2-content-heading">{{ section.settings.main_heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="map-locator-v2-content-description">{{ section.settings.description }}</p>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="map-locator-v2-stats">
          {% for block in section.blocks %}
            {% if block.type == 'stat' %}
              <div class="map-locator-v2-stat" {{ block.shopify_attributes }}>
                <div class="map-locator-v2-stat-number">{{ block.settings.stat_number }}</div>
                <div class="map-locator-v2-stat-label">{{ block.settings.stat_label }}</div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="map-locator-v2-globe-wrapper">
      <canvas id="map-locator-v2-canvas"></canvas>
    </div>
  </div>
</div>

<!-- Modal for store details -->
<div id="map-locator-v2-modal" class="map-locator-v2-modal">
  <div class="map-locator-v2-modal-content">
    <button class="map-locator-v2-modal-close" id="map-locator-v2-modal-close">&times;</button>
    <div id="map-locator-v2-modal-body"></div>
  </div>
</div>

<script>
  (function() {
    'use strict';

    class MapLocatorV2 {
      constructor(container, canvasId, config) {
        this.container = container;
        this.canvasId = canvasId;
        this.config = config;
        this.globe = null;
        this.scene = null;
        this.camera = null;
        this.renderer = null;
        this.controls = null;
        this.markers = [];
        this.autoRotateSpeed = config.rotationSpeed || 0.5;
        this.enableAutoRotate = config.autoRotate !== false;
        this.enableDrag = config.enableDrag !== false;
        this.isInitialized = false;
        this.animationFrameId = null;

        this.init();
      }

      async init() {
        if (this.isInitialized) return;

        try {
          await this.loadScripts();
          this.createScene();
          this.createGlobe();
          this.addMarkers();
          this.setupInteraction();
          this.animate();
          this.isInitialized = true;
        } catch (error) {
          console.error('MapLocatorV2 initialization error:', error);
        }
      }

      loadScripts() {
        return new Promise((resolve, reject) => {
          const requiredScripts = [
            { name: 'three', url: 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js', global: 'THREE' },
            { name: 'globe', url: 'https://unpkg.com/globe.gl@2.30.0/dist/globe.gl.min.js', global: 'Globe' }
          ];

          let loaded = 0;
          let errors = [];

          requiredScripts.forEach(script => {
            if (window[script.global]) {
              loaded++;
              if (loaded === requiredScripts.length) resolve();
              return;
            }

            const s = document.createElement('script');
            s.src = script.url;
            s.async = true;
            s.onload = () => {
              loaded++;
              if (loaded === requiredScripts.length) resolve();
            };
            s.onerror = () => {
              errors.push(`Failed to load ${script.name}`);
              if (errors.length >= requiredScripts.length) {
                reject(new Error(errors.join(', ')));
              }
            };
            document.head.appendChild(s);
          });
        });
      }

      createScene() {
        const canvas = document.getElementById(this.canvasId);
        if (!canvas) {
          throw new Error('Canvas element not found');
        }

        const width = canvas.parentElement.clientWidth;
        const height = canvas.parentElement.clientHeight;

        this.scene = new THREE.Scene();
        this.scene.background = new THREE.Color(0xffffff);
        this.scene.background.alpha = 0;

        this.camera = new THREE.PerspectiveCamera(75, width / height, 0.1, 10000);
        this.camera.position.z = 2.5;

        this.renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
        this.renderer.setSize(width, height);
        this.renderer.setPixelRatio(window.devicePixelRatio || 1);
        this.renderer.setClearColor(0xffffff, 0);

        window.addEventListener('resize', () => this.onWindowResize());
      }

      createGlobe() {
        this.globe = new Globe(this.scene, {
          waitForGlobeReady: true,
          animateIn: true
        });

        // Create custom globe texture with white oceans and light blue countries
        const canvas = document.createElement('canvas');
        canvas.width = 2048;
        canvas.height = 1024;
        const ctx = canvas.getContext('2d');

        // Fill with white (oceans)
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // Add light blue countries - simple pattern
        ctx.fillStyle = '#e8f4f8';
        for (let i = 0; i < canvas.width; i += 256) {
          for (let j = 0; j < canvas.height; j += 256) {
            if ((i / 256 + j / 256) % 2 === 0) {
              ctx.fillRect(i, j, 256, 256);
            }
          }
        }

        const texture = new THREE.CanvasTexture(canvas);
        this.globe.globeMaterial().map = texture;
        this.globe.globeMaterial().color.set(0xffffff);

        // Add atmosphere glow
        this.globe.atmosphereColor(this.config.atmosphereColor || '#b3d9ff');
        this.globe.atmosphereAltitude(0.15);

        // Set rotation
        this.globe.rotation.x = -0.3;
        this.globe.rotation.y = 0.5;
      }

      addMarkers() {
        const markersData = this.config.markers || [];

        markersData.forEach((marker, index) => {
          const geometry = new THREE.SphereGeometry(this.config.markerSize || 0.15, 32, 32);
          const material = new THREE.MeshStandardMaterial({
            color: new THREE.Color(marker.color || this.config.markerColor || '#ff6b6b'),
            emissive: new THREE.Color(marker.color || this.config.markerColor || '#ff6b6b'),
            emissiveIntensity: 0.5
          });

          const markerMesh = new THREE.Mesh(geometry, material);
          const coords = this.latLngToXyz(marker.latitude, marker.longitude);
          markerMesh.position.copy(coords);
          markerMesh.scale.set(1, 1, 1);

          this.globe.scene().add(markerMesh);

          this.markers.push({
            mesh: markerMesh,
            originalScale: 1,
            data: marker,
            index
          });

          // Add click event
          markerMesh.userData = { markerId: index };
        });
      }

      latLngToXyz(lat, lng) {
        const radius = 1;
        const phi = (90 - lat) * (Math.PI / 180);
        const theta = (lng + 180) * (Math.PI / 180);

        const x = -radius * Math.sin(phi) * Math.cos(theta);
        const y = radius * Math.cos(phi);
        const z = radius * Math.sin(phi) * Math.sin(theta);

        return new THREE.Vector3(x, y, z);
      }

      setupInteraction() {
        const canvas = this.renderer.domElement;
        let isDragging = false;
        let previousMousePosition = { x: 0, y: 0 };

        if (this.enableDrag) {
          canvas.addEventListener('mousedown', (e) => {
            isDragging = true;
            previousMousePosition = { x: e.clientX, y: e.clientY };
          });

          canvas.addEventListener('mousemove', (e) => {
            if (isDragging) {
              const deltaX = e.clientX - previousMousePosition.x;
              const deltaY = e.clientY - previousMousePosition.y;

              this.globe.rotation.y += deltaX * 0.01;
              this.globe.rotation.x += deltaY * 0.01;

              previousMousePosition = { x: e.clientX, y: e.clientY };
            }
          });

          canvas.addEventListener('mouseup', () => {
            isDragging = false;
          });

          canvas.addEventListener('mouseleave', () => {
            isDragging = false;
          });
        }

        // Marker hover and click
        canvas.addEventListener('click', (e) => this.onCanvasClick(e));
        canvas.addEventListener('mousemove', (e) => this.onCanvasMouseMove(e));
      }

      onCanvasClick(event) {
        const raycaster = new THREE.Raycaster();
        const mouse = new THREE.Vector2();

        const rect = this.renderer.domElement.getBoundingClientRect();
        mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
        mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;

        raycaster.setFromCamera(mouse, this.camera);

        const markerMeshes = this.markers.map(m => m.mesh);
        const intersects = raycaster.intersectObjects(markerMeshes);

        if (intersects.length > 0) {
          const clickedMarker = this.markers.find(m => m.mesh === intersects[0].object);
          if (clickedMarker) {
            this.rotateToMarker(clickedMarker);
            this.showMarkerModal(clickedMarker);
          }
        }
      }

      onCanvasMouseMove(event) {
        const raycaster = new THREE.Raycaster();
        const mouse = new THREE.Vector2();

        const rect = this.renderer.domElement.getBoundingClientRect();
        mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
        mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;

        raycaster.setFromCamera(mouse, this.camera);

        const markerMeshes = this.markers.map(m => m.mesh);
        const intersects = raycaster.intersectObjects(markerMeshes);

        this.markers.forEach(marker => {
          if (intersects.find(i => i.object === marker.mesh)) {
            marker.mesh.scale.set(1.3, 1.3, 1.3);
            this.renderer.domElement.style.cursor = 'pointer';
          } else {
            marker.mesh.scale.set(marker.originalScale, marker.originalScale, marker.originalScale);
            this.renderer.domElement.style.cursor = 'default';
          }
        });
      }

      rotateToMarker(marker) {
        const targetPosition = marker.mesh.position;
        const duration = 1000; // 1 second
        const startTime = Date.now();
        const startRotation = {
          x: this.globe.rotation.x,
          y: this.globe.rotation.y
        };

        const targetRotation = this.getRotationToFacePoint(targetPosition);
        const initialAutoRotate = this.enableAutoRotate;
        this.enableAutoRotate = false;

        const animate = () => {
          const elapsed = Date.now() - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const easeProgress = progress < 0.5 ? 2 * progress * progress : -1 + (4 - 2 * progress) * progress;

          this.globe.rotation.x = startRotation.x + (targetRotation.x - startRotation.x) * easeProgress;
          this.globe.rotation.y = startRotation.y + (targetRotation.y - startRotation.y) * easeProgress;

          if (progress < 1) {
            requestAnimationFrame(animate);
          } else {
            this.enableAutoRotate = initialAutoRotate;
          }
        };

        animate();
      }

      getRotationToFacePoint(point) {
        const target = new THREE.Vector3();
        target.copy(point).normalize();

        const rotation = {
          x: Math.asin(-target.y),
          y: Math.atan2(-target.x, -target.z)
        };

        return rotation;
      }

      showMarkerModal(marker) {
        const modal = document.getElementById('map-locator-v2-modal');
        const modalBody = document.getElementById('map-locator-v2-modal-body');
        const data = marker.data;

        let html = '';

        if (data.image) {
          html += `<img src="${data.image}" alt="${data.name}" class="map-locator-v2-modal-image">`;
        }

        html += `<div class="map-locator-v2-modal-name">${data.name}</div>`;
        html += `<div class="map-locator-v2-modal-meta"><span>${data.city}</span> • <span>${data.country}</span></div>`;

        if (data.description) {
          html += `<div class="map-locator-v2-modal-description">${data.description}</div>`;
        }

        html += '<div class="map-locator-v2-modal-info">';

        if (data.address) {
          html += `<div class="map-locator-v2-modal-info-row">
            <div class="map-locator-v2-modal-info-label">Address</div>
            <div class="map-locator-v2-modal-info-value">${data.address}</div>
          </div>`;
        }

        if (data.phone) {
          html += `<div class="map-locator-v2-modal-info-row">
            <div class="map-locator-v2-modal-info-label">Phone</div>
            <div class="map-locator-v2-modal-info-value"><a href="tel:${data.phone}">${data.phone}</a></div>
          </div>`;
        }

        if (data.email) {
          html += `<div class="map-locator-v2-modal-info-row">
            <div class="map-locator-v2-modal-info-label">Email</div>
            <div class="map-locator-v2-modal-info-value"><a href="mailto:${data.email}">${data.email}</a></div>
          </div>`;
        }

        if (data.website) {
          html += `<div class="map-locator-v2-modal-info-row">
            <div class="map-locator-v2-modal-info-label">Website</div>
            <div class="map-locator-v2-modal-info-value"><a href="${data.website}" target="_blank">Visit</a></div>
          </div>`;
        }

        html += '</div>';

        if (data.button_label && data.button_url) {
          html += `<a href="${data.button_url}" class="map-locator-v2-modal-button">${data.button_label}</a>`;
        }

        modalBody.innerHTML = html;
        modal.classList.add('active');
      }

      hideModal() {
        const modal = document.getElementById('map-locator-v2-modal');
        modal.classList.remove('active');
      }

      animate() {
        this.animationFrameId = requestAnimationFrame(() => this.animate());

        if (this.enableAutoRotate) {
          this.globe.rotation.y += this.autoRotateSpeed * 0.001;
        }

        this.renderer.render(this.scene, this.camera);
      }

      onWindowResize() {
        if (!this.renderer) return;

        const width = this.container.clientWidth;
        const height = this.container.clientHeight;

        this.camera.aspect = width / height;
        this.camera.updateProjectionMatrix();
        this.renderer.setSize(width, height);
      }

      destroy() {
        if (this.animationFrameId) {
          cancelAnimationFrame(this.animationFrameId);
        }

        if (this.renderer) {
          this.renderer.dispose();
          this.renderer.domElement.remove();
        }

        if (this.scene) {
          this.scene.clear();
        }

        this.markers = [];
        this.isInitialized = false;
      }
    }

    // Initialize on page load
    function initializeMapLocator() {
      const canvas = document.getElementById('map-locator-v2-canvas');
      if (!canvas) return;

      const globeWrapper = canvas.parentElement;

      // Gather marker data from blocks
      const markers = [];
      const statBlocks = document.querySelectorAll('[data-map-locator-marker]');

      statBlocks.forEach(block => {
        markers.push({
          name: block.dataset.storeName || '',
          latitude: parseFloat(block.dataset.latitude) || 0,
          longitude: parseFloat(block.dataset.longitude) || 0,
          country: block.dataset.country || '',
          city: block.dataset.city || '',
          address: block.dataset.address || '',
          phone: block.dataset.phone || '',
          email: block.dataset.email || '',
          website: block.dataset.website || '',
          image: block.dataset.image || '',
          description: block.dataset.description || '',
          button_label: block.dataset.buttonLabel || '',
          button_url: block.dataset.buttonUrl || '',
          color: block.dataset.markerColor || ''
        });
      });

      const config = {
        markers: markers,
        autoRotate: {{ section.settings.auto_rotate | default: true }},
        rotationSpeed: {{ section.settings.rotation_speed | default: 0.5 }},
        enableDrag: {{ section.settings.enable_drag | default: true }},
        markerColor: '{{ section.settings.marker_default_color }}',
        markerSize: 0.15,
        atmosphereColor: '{{ section.settings.atmosphere_color }}'
      };

      window.mapLocatorInstance = new MapLocatorV2(globeWrapper, 'map-locator-v2-canvas', config);
    }

    // Modal close handlers
    document.addEventListener('DOMContentLoaded', function() {
      initializeMapLocator();

      const modal = document.getElementById('map-locator-v2-modal');
      const closeBtn = document.getElementById('map-locator-v2-modal-close');

      if (closeBtn) {
        closeBtn.addEventListener('click', function() {
          if (window.mapLocatorInstance) {
            window.mapLocatorInstance.hideModal();
          }
        });
      }

      if (modal) {
        modal.addEventListener('click', function(event) {
          if (event.target === modal) {
            if (window.mapLocatorInstance) {
              window.mapLocatorInstance.hideModal();
            }
          }
        });
      }
    });

    // Handle Shopify theme editor reloads
    document.addEventListener('shopify:section:load', function() {
      if (window.mapLocatorInstance) {
        window.mapLocatorInstance.destroy();
        window.mapLocatorInstance = null;
      }
      initializeMapLocator();
    });

    document.addEventListener('shopify:section:unload', function() {
      if (window.mapLocatorInstance) {
        window.mapLocatorInstance.destroy();
        window.mapLocatorInstance = null;
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Map Locator V2",
  "settings": [
    {
      "type": "text",
      "id": "small_heading",
      "label": "Small Heading",
      "default": "Find a Store Near You"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "Good afternoon! Let's continue growing your business."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover our global network of stores and partners.</p>"
    },
    {
