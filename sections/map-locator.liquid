{% comment %}
  3D Map Locator Section
  A premium reusable 3D world map locator section using Globe.gl
{% endcomment %}

New globe

<!-- Three.js & Globe.gl -->
<script src="//unpkg.com/three"></script>
<script src="//unpkg.com/globe.gl"></script>
<!-- TopoJSON for country borders/dots -->
<script src="//unpkg.com/topojson-client"></script>

<style>
  .map-locator-section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    {% if section.settings.full_screen_section %}
    min-height: 100vh;
    {% endif %}
    font-family: inherit;
  }

  .map-locator-inner-{{ section.id }} {
    display: flex;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    align-items: center;
    gap: 40px;
    flex-direction: row;
    text-align: left;
    justify-content: space-between;
    position: relative;
    z-index: 2;
  }

  .map-locator-header-{{ section.id }} {
    flex: 1;
    max-width: 450px;
  }

  .map-locator-title {
    margin: 0 0 15px;
    font-size: 3rem;
    font-weight: 700;
    color: {{ section.settings.text_color }};
    line-height: 1.2;
  }

  .map-locator-subtitle {
    margin: 0 0 20px;
    font-size: 1.2rem;
    color: {{ section.settings.text_color }};
    opacity: 0.8;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 600;
  }
  
  .map-locator-description {
    color: {{ section.settings.text_color }};
    opacity: 0.9;
    line-height: 1.7;
    font-size: 1.15rem;
    margin-bottom: 40px;
  }

  /* Stats View */
  .map-locator-stats {
    display: flex;
    gap: 30px;
    margin-top: 40px;
    animation: fadeIn 0.4s ease;
  }

  .map-locator-stat {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .map-locator-stat-label {
    font-size: 0.9rem;
    color: {{ section.settings.text_color }};
    opacity: 0.7;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .map-locator-stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: {{ section.settings.text_color }};
  }

  /* Location Details View (Dynamic) */
  .map-locator-details {
    display: none;
    background: #fff;
    padding: 30px;
    border-radius: 16px;
    box-shadow: 0 15px 35px rgba(0,0,0,0.08);
    animation: slideUp 0.4s ease;
    border: 1px solid #f0f0f0;
    position: relative;
  }
  
  .map-locator-details-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: #f5f5f5;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: #333;
    transition: background 0.2s;
  }
  
  .map-locator-details-close:hover {
    background: #e0e0e0;
  }

  .map-loc-image {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 20px;
  }

  .map-loc-title {
    font-size: 1.6rem;
    margin: 0 0 10px;
    font-weight: 700;
    color: #111;
  }

  .map-loc-address {
    font-size: 1rem;
    color: #555;
    margin-bottom: 20px;
    line-height: 1.5;
  }

  .map-loc-contact {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 20px;
    padding-top: 20px;
    border-top: 1px solid #eee;
  }

  .map-loc-contact-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.95rem;
    color: #333;
  }
  
  .map-loc-contact-item svg {
    color: {{ section.settings.hex_color }};
  }

  .map-loc-desc {
    font-size: 0.95rem;
    color: #666;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .map-loc-btn {
    display: inline-block;
    width: 100%;
    text-align: center;
    background: #111;
    color: #fff;
    padding: 12px 20px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: background 0.3s;
    box-sizing: border-box;
  }

  .map-loc-btn:hover {
    background: #333;
  }

  /* Globe Container */
  .map-globe-wrapper-{{ section.id }} {
    flex: 1;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    position: relative;
    width: 100%;
  }

  .map-globe-container-{{ section.id }} {
    position: relative;
    width: 100%;
    max-width: {{ section.settings.globe_size_desktop }}px;
    aspect-ratio: 1 / 1;
    cursor: grab;
    transform: scale(1.1); /* Make it bleed nicely off right edge */
  }
  
  .map-globe-container-{{ section.id }}:active {
    cursor: grabbing;
  }

  /* Responsive adjustments */
  @media (min-width: 990px) {
    .map-globe-wrapper-{{ section.id }} {
      width: 55%;
      margin-right: -10%; /* Bleed off the right edge */
    }
  }

  @media (max-width: 989px) {
    .map-locator-inner-{{ section.id }} {
      flex-direction: column;
      text-align: center;
      gap: 30px;
    }
    .map-locator-header-{{ section.id }} {
      max-width: 100%;
    }
    .map-locator-stats {
      justify-content: center;
    }
    .map-globe-wrapper-{{ section.id }} {
      justify-content: center;
      margin-right: 0;
      width: 100%;
    }
    .map-globe-container-{{ section.id }} {
      max-width: {{ section.settings.globe_size_tablet }}px;
      transform: none;
    }
  }

  @media (max-width: 749px) {
    .map-locator-title {
      font-size: 2.2rem;
    }
    .map-globe-container-{{ section.id }} {
      max-width: {{ section.settings.globe_size_mobile }}px;
    }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<div class="map-locator-section-{{ section.id }}">
  <div class="map-locator-inner-{{ section.id }}">
    
    <div class="map-locator-header-{{ section.id }}">
      {%- if section.settings.subtitle != blank -%}
        <h3 class="map-locator-subtitle">{{ section.settings.subtitle }}</h3>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="map-locator-title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="map-locator-description">{{ section.settings.description }}</div>
      {%- endif -%}

      <!-- Default Stats View -->
      <div id="locator-stats-{{ section.id }}" class="map-locator-stats" {% if section.settings.show_stats == false %}style="display:none;"{% endif %}>
        <div class="map-locator-stat">
          <span class="map-locator-stat-label">Total Locations</span>
          <span class="map-locator-stat-value">{{ section.blocks.size }}</span>
        </div>
        <div class="map-locator-stat">
          <span class="map-locator-stat-label">Global Presence</span>
          <span class="map-locator-stat-value">Worldwide</span>
        </div>
      </div>

      <!-- Dynamic Location Details View -->
      <div id="locator-details-{{ section.id }}" class="map-locator-details">
        <!-- Content injected via JS -->
      </div>
    </div>

    <div id="globe-wrapper-{{ section.id }}" class="map-globe-wrapper-{{ section.id }}">
      <div id="globe-container-{{ section.id }}" class="map-globe-container-{{ section.id }}">
        <!-- Globe Canvas will be injected here -->
      </div>
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    init3DGlobe_{{ section.id | replace: '-', '_' }}();
  });

  // Handle Shopify Theme Editor events cleanly
  document.addEventListener('shopify:section:load', function(event) {
    if (event.detail.sectionId === '{{ section.id }}') {
      init3DGlobe_{{ section.id | replace: '-', '_' }}();
    }
  });

  function init3DGlobe_{{ section.id | replace: '-', '_' }}() {
    const container = document.getElementById('globe-container-{{ section.id }}');
    if (!container) return;

    // Clear previous instances if any
    container.innerHTML = '';

    // Gather block locations
    const locations = [
      {%- for block in section.blocks -%}
        {
          id: "{{ block.id }}",
          lat: parseFloat("{{ block.settings.latitude | default: '0' }}") || 0,
          lng: parseFloat("{{ block.settings.longitude | default: '0' }}") || 0,
          storeName: {{ block.settings.store_name | json }},
          country: {{ block.settings.country | json }},
          city: {{ block.settings.city | json }},
          address: {{ block.settings.address | json }},
          phone: {{ block.settings.phone | json }},
          email: {{ block.settings.email | json }},
          website: {{ block.settings.website | json }},
          description: {{ block.settings.description | json }},
          image: {% if block.settings.image %}{{ block.settings.image | image_url: width: 600 | json }}{% else %}null{% endif %},
          btnLabel: {{ block.settings.button_label | json }},
          btnUrl: {{ block.settings.button_url | json }},
          color: "{{ block.settings.marker_color | default: '#000000' }}",
          size: {{ block.settings.marker_size | default: 34 }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ].filter(l => l.lat !== 0 || l.lng !== 0);

    // Safe fallbacks in case Theme Editor hasn't saved the new settings yet
    const waterColor = '{{ section.settings.water_color }}' || '#e0f2fe';
    const landColor = '{{ section.settings.land_color }}' || '#ffffff';
    const borderColor = '{{ section.settings.map_border_color }}' || '#bae6fd';
    const atmosColor = '{{ section.settings.atmosphere_color }}' || '#bae6fd';

    // Initialize Globe
    const globe = Globe()(container)
      .backgroundColor('rgba(0,0,0,0)')
      .showGlobe(true)
      .showAtmosphere(true)
      .globeColor(waterColor)
      .atmosphereColor(atmosColor)
      .atmosphereAltitude(0.15)
      .width(container.clientWidth)
      .height(container.clientHeight);

    // Apply bright shading to the globe to prevent any black shadows
    const material = globe.globeMaterial();
    material.color = new THREE.Color(waterColor); 
    material.emissive = new THREE.Color(waterColor); 
    material.emissiveIntensity = 0.5;

    // Ensure scene is brightly lit unconditionally
    setTimeout(() => {
      if (globe.scene) {
        const scene = globe.scene();
        scene.add(new THREE.AmbientLight(0xffffff, 2.0)); // Strong white ambient light
      }
    }, 100);

    // Fetch GeoJSON and render proper map polygons (no longer dotted)
    fetch('https://unpkg.com/world-atlas/countries-110m.json')
      .then(res => res.json())
      .then(world => {
        const countries = topojson.feature(world, world.objects.countries).features;
        
        globe.polygonsData(countries)
          .polygonCapColor(() => landColor)
          .polygonSideColor(() => 'rgba(255, 255, 255, 0.4)')
          .polygonStrokeColor(() => borderColor)
          .polygonAltitude(0.01);
      });

    // Add HTML Markers
    globe.htmlElementsData(locations)
      .htmlElement(d => {
        const el = document.createElement('div');
        // Center bottom tip on coordinate
        el.style.transform = 'translate(-50%, -100%)';
        el.style.pointerEvents = 'none';
        
        const svgWrapper = document.createElement('div');
        svgWrapper.innerHTML = `
          <svg width="${d.size}" height="${d.size * 1.3}" viewBox="0 0 24 34" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 0C5.373 0 0 5.373 0 12c0 7.857 11.233 21.285 11.583 21.71a.5.5 0 00.834 0C12.767 33.285 24 19.857 24 12c0-6.627-5.373-12-12-12zm0 17.5a5.5 5.5 0 110-11 5.5 5.5 0 010 11z" fill="${d.color}"/>
          </svg>
        `;
        svgWrapper.style.pointerEvents = 'auto';
        svgWrapper.style.cursor = 'pointer';
        svgWrapper.style.transition = 'transform 0.2s';
        
        svgWrapper.onmouseenter = () => {
          svgWrapper.style.transform = 'scale(1.2) translateY(-5px)';
        };
        svgWrapper.onmouseleave = () => {
          svgWrapper.style.transform = 'scale(1) translateY(0)';
        };
        
        // On Click
        svgWrapper.onclick = () => {
          // Zoom into point
          globe.pointOfView({ lat: d.lat, lng: d.lng, altitude: 0.8 }, 1000);
          showLocationDetails(d);
        };
        
        el.appendChild(svgWrapper);
        return el;
      });

    // Controls setup
    globe.controls().enableZoom = {{ section.settings.enable_zoom }};
    globe.controls().autoRotate = {{ section.settings.auto_rotate }};
    globe.controls().autoRotateSpeed = 0.5;
    
    // Restrict zoom distances to prevent the camera from clipping/cutting into the globe
    globe.controls().minDistance = 140; 
    globe.controls().maxDistance = 600;

    // Focus on first marker if available
    if (locations.length > 0) {
      setTimeout(() => {
        globe.pointOfView({ lat: locations[0].lat, lng: locations[0].lng, altitude: 2 }, 1500);
      }, 500);
    }

    // Handle Window Resize
    window.addEventListener('resize', () => {
      globe.width(container.clientWidth);
      globe.height(container.clientHeight);
    });
    
    // UI Logic to show details on left panel
    function showLocationDetails(loc) {
      const statsDiv = document.getElementById(`locator-stats-{{ section.id }}`);
      const detailsDiv = document.getElementById(`locator-details-{{ section.id }}`);
      
      if (statsDiv) statsDiv.style.display = 'none';
      
      let html = `
        <button class="map-locator-details-close" onclick="closeLocationDetails_{{ section.id | replace: '-', '_' }}()" title="Back to overview">&times;</button>
      `;
      
      if (loc.image) {
        html += `<img src="${loc.image}" alt="${loc.storeName}" class="map-loc-image" loading="lazy">`;
      }
      
      html += `<h4 class="map-loc-title">${loc.storeName}</h4>`;
      
      if (loc.address || loc.city || loc.country) {
        let addr = loc.address ? loc.address.replace(/\n/g, '<br>') : '';
        if (loc.city && loc.country) {
          addr += (addr ? '<br>' : '') + `${loc.city}, ${loc.country}`;
        }
        html += `<div class="map-loc-address">${addr}</div>`;
      }
      
      if (loc.phone || loc.email) {
        html += `<div class="map-loc-contact">`;
        if (loc.phone) {
          html += `<div class="map-loc-contact-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <a href="tel:${loc.phone}" style="color:inherit;text-decoration:none;">${loc.phone}</a>
          </div>`;
        }
        if (loc.email) {
          html += `<div class="map-loc-contact-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <a href="mailto:${loc.email}" style="color:inherit;text-decoration:none;">${loc.email}</a>
          </div>`;
        }
        html += `</div>`;
      }
      
      if (loc.description) {
        html += `<div class="map-loc-desc">${loc.description}</div>`;
      }
      
      if ((loc.btnLabel && loc.btnUrl) || loc.website) {
        if (loc.btnLabel && loc.btnUrl) {
          html += `<a href="${loc.btnUrl}" class="map-loc-btn">${loc.btnLabel}</a>`;
        } else if (loc.website) {
          html += `<a href="${loc.website}" target="_blank" class="map-loc-btn">Visit Website</a>`;
        }
      }
      
      detailsDiv.innerHTML = html;
      detailsDiv.style.display = 'block';
    }

    // Global function to close details
    window['closeLocationDetails_{{ section.id | replace: "-", "_" }}'] = function() {
      const statsDiv = document.getElementById(`locator-stats-{{ section.id }}`);
      const detailsDiv = document.getElementById(`locator-details-{{ section.id }}`);
      
      detailsDiv.style.display = 'none';
      {% if section.settings.show_stats %}
      if (statsDiv) statsDiv.style.display = 'flex';
      {% endif %}
      
      // Zoom out slightly to see more of the globe
      globe.pointOfView({ altitude: 2 }, 1000);
    };
  }
</script>

