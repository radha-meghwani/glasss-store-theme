<div class="image-w-text">
    <div class="img-container">
            <div class="images-block">
                <div class="main-image">
                {% if section.settings.custom-image != blank %}
                    <img class="block-image" src="{{ section.settings.custom-image | img_url:'master' }}" alt="block-image" loading="lazy">
                {% endif %}
                </div>
                <div class="image-content">
                    <h4>{{ section.settings.content_heading }}</h4>
                    <p>{{ section.settings.content_para }}</p>
                </div> 
            </div>

            <div class="images-block2">
                <div class="main-image">
                {% if section.settings.custom-image2 != blank %}
                    <img class="block-image" src="{{ section.settings.custom-image2 | img_url:'master' }}" alt="block-image" loading="lazy">
                {% endif %}
                </div>
                <div class="image-content">
                    <h4>{{ section.settings.content_heading2 }}</h4>
                    <p>{{ section.settings.content_para2 }}</p>
                </div> 
            </div>
    </div>
</div>

<style>
.image-w-text {
    padding: 40px 0px 40px 0px;
}
.img-container {
    max-width: 1200px;
    margin: auto;
}
.main-image img {
    height: 100%;
    width: 100%;
    object-fit: cover;
    padding: 30px 20px 25px 45px;
}
.images-block {
    display: flex;
    width: 100%;
}
.images-block2 {
    display: flex;
    flex-direction: row-reverse;
    width: 100%;
}
.main-image {
    width: 50%;
}
.image-content {
    width: 50%;
    padding: 55px 73px 0px 58px;
    display: flex;
    flex-direction: column;
    justify-content: center;
}
.image-content h4{
    font-size: 28px;
    line-height: 30px;
    color: #1a1a1a;
    font-weight: 700;
    margin: 0px 0px 20px;
}
.image-content p{
    font-size: 16px;
    color: #6a6a6a;
    line-height: 24px;
    margin: 0;
}

@media(max-width:480px){
.images-block {
    flex-direction: column;
}
.main-image {
    width: 100%;
}
.image-content {
    width: 100%;
    padding: 0px 24px 0px 44px;
}
.images-block2 {
    flex-direction: column;
}
}

</style>

{% schema %}
{
    "name": "custom-image-w-text",
    "settings": [
             {
              "type": "text",
              "id": "content_heading",
              "label": "content_heading"
            },
            {
                "type": "text",
                "id": "content_para",
                "label": "content_para"
            },
            {
                "type": "image_picker",
                "id": "custom-image",
                "label": "custom-image"
            },
              {
              "type": "text",
              "id": "content_heading2",
              "label": "content_heading2"
            },
            {
                "type": "text",
                "id": "content_para2",
                "label": "content_para2"
            },
            {
                "type": "image_picker",
                "id": "custom-image2",
                "label": "custom-image2"
            }
    ],

    "presets": [
        {
           "name": "custom-image-w-text",
           "category": "custom"
        }
    ]
}
{% endschema %}