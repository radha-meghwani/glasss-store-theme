{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .testimonial-redesign-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#07050a' }};
    color: #fff;
    font-family: inherit;
    overflow: hidden;
  }

  /* Header */
  .testimonial-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .testimonial-badge {
    color: #a855f7;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }

  .testimonial-title {
    color: #ffffff;
    font-size: clamp(32px, 4vw, 48px);
    margin: 0 0 16px 0;
    font-weight: 400;
    font-family: serif;
    letter-spacing: 1px;
  }

  .testimonial-subtitle {
    color: #a3a3a3;
    font-size: 15px;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* Rating Row with Navigation */
  .testimonial-rating-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto 32px auto;
    padding: 0 20px;
    position: relative;
  }

  .stat-icon img{
    height:80px;
    width:80px;
  }

  .testimonial-rating-center {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    flex: 1;
  }

  .testimonial-rating-stars-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .testimonial-rating-stars {
    color: #a855f7;
    font-size: 24px;
    letter-spacing: 2px;
  }

  .testimonial-rating-score {
    font-size: 20px;
    font-weight: 600;
    color: #fff;
  }

  .testimonial-rating-divider {
    width: 1px;
    height: 30px;
    background: rgba(255,255,255,0.2);
  }

  .testimonial-rating-text {
    display: flex;
    flex-direction: row;
    font-size: 12px;
    color: #a3a3a3;
    line-height: 1.4;
    align-items:center;
  }

  .jdgme-rating{
    display: flex;
    flex-direction: column;
  }

  .testimonial-rating-text strong {
    color: #fff;
    font-weight: 500;
  }

  /* Navigation Arrows */
  .testimonial-slider-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(168, 85, 247, 0.4);
    background: transparent;
    color: transparent;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 10;
  }
  
  .testimonial-slider-nav:hover {
    background: rgba(168, 85, 247, 0.1);
    border-color: #a855f7;
  }

  .testimonial-slider-nav::before {
    content: '';
    display: block;
    width: 8px;
    height: 8px;
    border-top: 2px solid #a3a3a3;
    border-right: 2px solid #a3a3a3;
    transition: border-color 0.3s ease;
  }

  .judgeme-img img{
    height:30px;
    width:30px;    
  }

  .testimonial-slider-nav:hover::before {
    border-color: #fff;
  }

  .testimonial-slider-prev::before {
    transform: rotate(-135deg);
    margin-left: 4px;
  }

  .testimonial-slider-next::before {
    transform: rotate(45deg);
    margin-right: 4px;
  }

  /* Slider Container */
  .testimonial-slider-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 10px;
  }

  /* Card */
  .testimonial-redesign-{{ section.id }} .testimonial-card {
    display: flex !important;
    background: #0d0914;
    border: 1px solid rgba(168, 85, 247, 0.15);
    border-radius: 16px;
    padding: 16px;
    margin: 0 10px;
    transition: all 0.3s ease;
    height: 100%;
    min-height: 280px;
  }
  
  {% if section.settings.image_position == 'top' %}
  .testimonial-redesign-{{ section.id }} .testimonial-card {
    flex-direction: column;
  }
  .testimonial-redesign-{{ section.id }} .testimonial-card__image-container {
    flex: 0 0 auto;
    width: 100%;
    height: 200px;
    margin-right: 0;
    margin-bottom: 16px;
  }
  {% else %}
  .testimonial-redesign-{{ section.id }} .testimonial-card {
    flex-direction: row;
  }
  .testimonial-redesign-{{ section.id }} .testimonial-card__image-container {
    flex: 0 0 45%;
    margin-right: 16px;
  }
  {% endif %}

  .testimonial-redesign-{{ section.id }} .testimonial-card:hover {
    border-color: rgba(168, 85, 247, 0.4);
    box-shadow: 0 10px 40px rgba(168, 85, 247, 0.08);
  }

  .testimonial-redesign-{{ section.id }} .testimonial-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 12px;
  }

  .testimonial-redesign-{{ section.id }} .testimonial-card__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    position: relative;
    padding: 4px 0;
  }

  .testimonial-redesign-{{ section.id }} .testimonial-card__top-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
  }

  .testimonial-redesign-{{ section.id }} .testimonial-card__stars {
    color: #a855f7;
    font-size: 14px;
    letter-spacing: 2px;
    margin-bottom: 6px;
  }

  .testimonial-redesign-{{ section.id }} .testimonial-card__verified {
    color: #8b8b8b;
    font-size: 11px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .testimonial-redesign-{{ section.id }} .verified-icon {
    color: #a855f7;
    font-size: 12px;
  }

  .testimonial-redesign-{{ section.id }} .testimonial-card__quote-icon {
    color: rgba(168, 85, 247, 0.2);
    font-size: 40px;
    line-height: 0.5;
    font-family: serif;
    margin-top: 10px;
  }

  .testimonial-redesign-{{ section.id }} .testimonial-card__review {
    color: #d4d4d4;
    font-size: 13px;
    line-height: 1.6;
    flex-grow: 1;
    margin-bottom: 16px;
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .testimonial-redesign-{{ section.id }} .testimonial-card__author-name {
    color: #a855f7;
    font-weight: 600;
    font-size: 13px;
    margin-bottom: 2px;
  }
  
  .testimonial-redesign-{{ section.id }} .testimonial-card__product {
    color: #8b8b8b;
    font-size: 12px;
  }

  /* Dots */
  .testimonial-redesign-{{ section.id }} .slick-dots {
    display: flex;
    justify-content: center;
    list-style: none;
    padding: 0;
    margin: 30px 0 0 0;
    gap: 8px;
  }
  
  .testimonial-redesign-{{ section.id }} .slick-dots li {
    margin: 0;
  }
  
  .testimonial-redesign-{{ section.id }} .slick-dots button {
    font-size: 0;
    line-height: 0;
    display: block;
    width: 6px;
    height: 6px;
    padding: 0;
    cursor: pointer;
    color: transparent;
    border: 0;
    outline: none;
    background: rgba(168, 85, 247, 0.3);
    border-radius: 50%;
    transition: all 0.3s ease;
  }
  
  .testimonial-redesign-{{ section.id }} .slick-dots li.slick-active button {
    background: #a855f7;
    transform: scale(1.3);
  }

  /* Button */
  .testimonial-button-wrapper {
    text-align: center;
    margin-top: 40px;
  }

  .testimonial-redesign-{{ section.id }} .testimonial-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: transparent;
    border: 1px solid rgba(168, 85, 247, 0.5);
    color: #a855f7;
    padding: 12px 32px;
    border-radius: 10px;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
  }

  .testimonial-redesign-{{ section.id }} .testimonial-button:hover {
    background: rgba(168, 85, 247, 0.1);
    border-color: #a855f7;
    color: #fff;
  }

  /* Stats */
  .testimonial-stats-container {
    max-width: 1200px;
    margin: 60px auto 0 auto;
    padding: 0 20px;
  }
  
  .testimonial-redesign-{{ section.id }} .testimonial-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: #0d0914;
    border-radius: 8px;
    padding: 30px;
    border: 1px solid rgba(168, 85, 247, 0.1);
  }

  .testimonial-redesign-{{ section.id }} .testimonial-stat {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    border-right: 1px solid rgba(255,255,255,0.05);
    padding: 0 10px;
  }
  .testimonial-redesign-{{ section.id }} .testimonial-stat:last-child {
    border-right: none;
  }

  /* .testimonial-redesign-{{ section.id }} .stat-icon {
    width: 32px;
    height: 32px;
    color: #a855f7;
    display: flex;
    align-items: center;
    justify-content: center;
  } */
  .testimonial-redesign-{{ section.id }} .stat-icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .testimonial-redesign-{{ section.id }} .stat-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .testimonial-redesign-{{ section.id }} .stat-value {
    font-size: 18px;
    font-weight: 600;
    color: #fff;
    line-height: 1.2;
  }

  .testimonial-redesign-{{ section.id }} .stat-label {
    font-size: 11px;
    color: #8b8b8b;
  }
  
  .testimonial-redesign-{{ section.id }} .slick-track {
    display: flex !important;
  }
  
  .testimonial-redesign-{{ section.id }} .slick-slide {
    height: inherit !important;
    display: flex !important;
  }

  @media screen and (max-width: 1024px) {
    .testimonial-redesign-{{ section.id }} .testimonial-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px 0;
    }
    .testimonial-redesign-{{ section.id }} .testimonial-stat:nth-child(2) {
      border-right: none;
    }
    .testimonial-redesign-{{ section.id }} .testimonial-stat:nth-child(3) {
      border-top: 1px solid rgba(255,255,255,0.05);
      padding-top: 30px;
    }
    .testimonial-redesign-{{ section.id }} .testimonial-stat:nth-child(4) {
      border-top: 1px solid rgba(255,255,255,0.05);
      padding-top: 30px;
    }
    .testimonial-rating-row {
      flex-direction: column;
      gap: 20px;
    }
    .testimonial-slider-nav {
      display: none !important; /* Hide custom arrows on mobile/tablet if needed, or adjust */
    }
  }

  @media screen and (max-width: 768px) {
    {% if section.settings.image_position == 'left' %}
    /* Force column on mobile even if left is selected */
    .testimonial-redesign-{{ section.id }} .testimonial-card {
      flex-direction: column;
    }
    .testimonial-redesign-{{ section.id }} .testimonial-card__image-container {
      width: 100%;
      height: 250px;
      margin-right: 0;
      margin-bottom: 16px;
    }
    {% endif %}
    
    .testimonial-redesign-{{ section.id }} .testimonial-stats {
      grid-template-columns: 1fr;
      gap: 20px 0;
    }
    .testimonial-redesign-{{ section.id }} .testimonial-stat {
      border-right: none;
      border-bottom: 1px solid rgba(255,255,255,0.05);
      padding-bottom: 20px;
      justify-content: flex-start;
      padding-left: 20px;
    }
    .testimonial-redesign-{{ section.id }} .testimonial-stat:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }
    .testimonial-redesign-{{ section.id }} .testimonial-stat:nth-child(3),
    .testimonial-redesign-{{ section.id }} .testimonial-stat:nth-child(4) {
      border-top: none;
      padding-top: 0;
    }
  }
{% endstyle %}

<!-- Load Slick CSS -->
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>

<section class="section-{{ section.id }}-padding testimonial-redesign-{{ section.id }}">
  <div class="page-width">
    
    <!-- Header -->
    <div class="testimonial-header">
      <div class="testimonial-badge">{{section.settings.badge}}</div>
      {% if section.settings.title != blank %}
        <h2 class="testimonial-title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="testimonial-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <!-- Rating Row & Custom Navigation -->
    <div class="testimonial-rating-row">
      <div class="testimonial-slider-nav testimonial-slider-prev" id="custom-prev-{{ section.id }}"></div>
      
      <div class="testimonial-rating-center">
        <div class="testimonial-rating-stars-wrap">
          <div class="testimonial-rating-stars">{{section.settings.rating-stars}}</div>
          <div class="testimonial-rating-score">{{ section.settings.rating_score | default: '4.9/5' }}</div>
        </div>
        <div class="testimonial-rating-divider"></div>
        <div class="testimonial-rating-text">
          <div class="jdgme-rating">
          <strong>{{ section.settings.rating_reviews | default: '2,000+ Reviews' }}</strong>
          <span>{{section.settings.verified}}</span>
          </div>
          <div class="judgeme-img">
            {% if section.settings.judge_me != blank %}
              <img src="{{section.settings.judge_me | img_url:'master' }}" alt="image" loading="lazy">
            {% endif %}
          </div>
        </div>
      </div>
      
      <div class="testimonial-slider-nav testimonial-slider-next" id="custom-next-{{ section.id }}"></div>
    </div>

    <!-- Slider -->
    <div class="testimonial-slider-container">
      <div class="testimonial-slider slick-slider" id="testimonial-slider-{{ section.id }}">
        {% for block in section.blocks %}
          {% if block.type == 'quote' %}
            <div class="testimonial-card">
              <!-- Left/Top: Image -->
              <div class="testimonial-card__image-container">
                 {% if block.settings.img != blank %}
                   <img src="{{ block.settings.img | img_url: '400x500', crop: 'center' }}" alt="{{ block.settings.author }}" class="testimonial-card__image">
                 {% else %}
                   {{ 'image' | placeholder_svg_tag: 'testimonial-card__image placeholder-svg' }}
                 {% endif %}
              </div>
              
              <!-- Right/Bottom: Content -->
              <div class="testimonial-card__content">
                 <div class="testimonial-card__top-row">
                   <div class="testimonial-card__rating-wrap">
                     <div class="testimonial-card__stars">
                       {% for i in (1..block.settings.rating) %}★{% endfor %}
                     </div>
                     {% if block.settings.verified_buyer %}
                       <div class="testimonial-card__verified">
                         <span class="verified-icon">☑</span> Verified Customer
                       </div>
                     {% endif %}
                   </div>
                   <div class="testimonial-card__quote-icon">”</div>
                 </div>
                 
                 <div class="testimonial-card__review">
                   {% if block.settings.quote != blank %}
                     {{ block.settings.quote | strip_html }}
                   {% endif %}
                 </div>
                 
                 <div class="testimonial-card__author-info">
                   <div class="testimonial-card__author-name">{{ block.settings.author }}</div>
                   {% if block.settings.product_name != blank %}
                     <div class="testimonial-card__product">{{ block.settings.product_name }}</div>
                   {% endif %}
                 </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- Button -->
    {% if section.settings.button_label != blank and section.settings.link != blank %}
      <div class="testimonial-button-wrapper">
        <a href="{{ section.settings.link }}" class="testimonial-button">
          {{ section.settings.button_label }} <span style="margin-left:4px;">→</span>
        </a>
      </div>
    {% endif %}

    <!-- Dynamic Stats -->
    {% assign stat_blocks = section.blocks | where: "type", "stat" %}
    {% if stat_blocks.size > 0 %}
    <div class="testimonial-stats-container">
      <div class="testimonial-stats">
        {% for block in stat_blocks %}
          <div class="testimonial-stat" {{ block.shopify_attributes }}>
            <div class="stat-icon">
              {% if block.settings.icon_svg != blank %}
                <img src="{{ block.settings.icon_svg | img_url:'master' }}" alt="image" loading="lazy">
              {% else %}
                <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {% endif %}
            </div>
            <div class="stat-text">
              <div class="stat-value">{{ block.settings.value }}</div>
              <div class="stat-label">{{ block.settings.label }}</div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
    
  </div>
</section>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var $slider = $('#testimonial-slider-{{ section.id }}');
  
  $slider.slick({
    dots: true,
    infinite: true,
    autoplay: false,
    speed: 300,
    arrows: true,
    prevArrow: $('#custom-prev-{{ section.id }}'),
    nextArrow: $('#custom-next-{{ section.id }}'),
    slidesToShow: 3,
    slidesToScroll: 1,
    centerMode: false,
    responsive: [
      {
        breakpoint: 1024,
        settings: {
          slidesToShow: 2,
          slidesToScroll: 1
        }
      },
      {
        breakpoint: 768,
        settings: {
          slidesToShow: 1,
          slidesToScroll: 1,
          arrows: false /* hide custom arrows on mobile if desired, or keep them */
        }
      }
    ]
  });
});
</script>

{% schema %}
  {
    "name": "Testimonials",
    "class": "index-section",
    "settings": [
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background color",
        "default": "#07050a"
      },
      {
        "type": "text",
        "id": "badge",
        "label": "Badge"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "LOVED BY 5000+ CUSTOMERS"
      },
      {
        "type": "text",
        "id": "subtitle",
        "label": "Subtitle",
        "default": "See why cosplayers and fantasy lovers choose PRIMAL® contact lenses to complete their transformation."
      },
      {
        "type": "text",
        "id": "rating-stars",
        "label": "rating-stars"
      },
      {
        "type": "text",
        "id": "rating_score",
        "label": "Rating Score (Header)",
        "default": "4.9/5"
      },
      {
        "type": "text",
        "id": "rating_reviews",
        "label": "Rating Reviews (Header)",
        "default": "2,000+ Reviews"
      },
      {
        "type": "text",
        "id": "verified",
        "label": "verified review"
      },
      {
        "type": "image_picker",
        "id": "judge_me",
        "label": "Judge-me icon"
      },
      {
        "type": "select",
        "id": "image_position",
        "label": "Card Image Position",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "top",
            "label": "Top"
          }
        ],
        "default": "left"
      },
      {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 100
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 100
      },
      {
        "type": "header",
        "content": "View more button"
      },
      {
        "type": "text",
        "id": "button_label",
        "default": "VIEW ALL REVIEWS",
        "label": "Button text"
      },
      {
        "type": "url",
        "id": "link",
        "label": "Button Link"
      }
    ],
    "blocks": [
      {
        "type": "quote",
        "name": "Testimonial",
        "settings": [
          {
            "type": "range",
            "id": "rating",
            "min": 1,
            "max": 5,
            "step": 1,
            "label": "Rating",
            "default": 5
          },
          {
            "type": "checkbox",
            "id": "verified_buyer",
            "label": "Show Verified Customer",
            "default": true
          },
          {
            "type": "richtext",
            "id": "quote",
            "label": "Review Text",
            "default": "<p>These lenses are beyond amazing! The color is so vibrant and looks super natural even up close. Perfect for my cosplay!</p>"
          },
          {
            "type": "text",
            "id": "author",
            "label": "Customer Name",
            "default": "Luna K."
          },
          {
            "type": "text",
            "id": "product_name",
            "label": "Product Name",
            "default": "Succubus Purple"
          },
          {
            "type": "image_picker",
            "id": "img",
            "label": "Customer Image"
          }
        ]
      },
      {
        "type": "stat",
        "name": "Icons",
        "limit": 4,
        "settings": [
          {
            "type": "image_picker",
            "id": "icon_svg",
            "label": "Icon (Svg Image)"
          },
          {
            "type": "text",
            "id": "value",
