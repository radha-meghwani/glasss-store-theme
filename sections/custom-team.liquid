{% comment %} swiper {% endcomment %}

.team-section {
  max-width: 1200px;
  margin: 80px auto;
  padding: 0 15px;
  overflow: hidden;
}

/* wrapper */
.team-slider-wrapper {
  position: relative;
  overflow: hidden;
}

/* slider track */
.team-block {
  display: flex;
  transition: transform 0.4s ease;
  will-change: transform;
}

/* slide */
.team-member {
  flex: 0 0 25%;
  padding: 17px;
  box-sizing: border-box;
}

/* image */
.member-img img {
  width: 100%;
  height: auto;
  display: block;
}

/* arrows */
.team-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 37px;
  height: 37px;
  border: none;
  background: #ebbaa9;
  color: #000;
  font-size: 18px;
  cursor: pointer;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.team-prev { left: 3px; }
.team-next { right: 3px; }

/* hide arrows desktop */
@media (min-width: 991px) {
  .team-arrow {
    display: none;
  }
}

@media (max-width: 990px) {
  .team-member {
    flex: 0 0 33.333%;
  }

  .team-arrow {
    display: flex;
  }
}

@media (max-width: 560px) {
  .team-member {
    flex: 0 0 100%;
  }

  .team-arrow {
    width: 38px;
    height: 38px;
  }
}

.team-social {
  display: flex;
  gap: 7px;
  justify-content: center;
  position: relative;
  bottom: 65px;
  opacity: 0;
  transform: translateY(15px);
  transition: opacity 0.3s ease, transform 0.3s ease;
  z-index: 2;
}

.team-member:hover .team-social {
  opacity: 1;
  transform: translateY(0);
}

@media (max-width:480px){
.team-arrow {
    width: 33px;
    height: 33px;
}
.team-next {
    right: 30px;
}
.team-prev { 
    left: 30px; 
}
.member-info h4 {
    margin: -7px 0 13px 0;
}
}

</style>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const slider = document.querySelector(".team-block");
  const slides = document.querySelectorAll(".team-member");
  const prevBtn = document.querySelector(".team-prev");
  const nextBtn = document.querySelector(".team-next");

  let index = 0;
  let startX = 0;
  let currentTranslate = 0;

  function slidesPerView() {
    if (window.innerWidth <= 560) return 1;
    if (window.innerWidth <= 990) return 3;
    return slides.length;
  }

  function updateSlider() {
    const slideWidth = slider.offsetWidth / slidesPerView();
    currentTranslate = index * slideWidth;
    slider.style.transform = `translateX(-${currentTranslate}px)`;
  }

  nextBtn.addEventListener("click", () => {
    if (index < slides.length - slidesPerView()) {
      index++;
      updateSlider();
    }
  });

  prevBtn.addEventListener("click", () => {
    if (index > 0) {
      index--;
      updateSlider();
    }
  });

  /* touch swipe */
  slider.addEventListener("touchstart", e => {
    startX = e.touches[0].clientX;
  });

  slider.addEventListener("touchend", e => {
    const endX = e.changedTouches[0].clientX;
    const diff = startX - endX;

    if (diff > 50) nextBtn.click();
    if (diff < -50) prevBtn.click();
  });

  window.addEventListener("resize", () => {
    index = 0;
    updateSlider();
  });
});
</script>

