<div class="custom-team">

    <div class="team-section">

        <h4>{{ section.settings.team_heading }}</h4>
        <h6>{{ section.settings.team_subheading }}</h6>

        <div class="team-slider-wrapper">
  
  <button class="team-arrow team-prev">❮</button>

        <div class="team-block">
            {% for block in section.blocks %}
                <div class="team-member">
                    <div class="member-img">
                        {% if block.settings.members_img != blank %}
                        <img class="members-img" src="{{ block.settings.members_img | img_url: 'master' }}" alt="team-member-img">
                        {% endif %}

                        <div class="social-icons">
                            <ul class="team-social">

                            <li class="team-icons">
                                <div class="icons-box">
                                <i class="{{ block.settings.twitter_icon }}"></i>
                                </div>
                            </li>

                             <li class="team-icons">
                                <div class="icons-box">
                                <i class="{{ block.settings.fb_icon }}"></i>
                                </div>
                            </li>

                             <li class="team-icons">
                                <div class="icons-box">
                                <i class="{{ block.settings.printrest_icon }}"></i>
                                </div>
                            </li>

                             <li class="team-icons">
                                <div class="icons-box">
                                <i class="{{ block.settings.insta_icon }}"></i>
                                </div>
                            </li>
    
                            </ul>
                        </div>

                    </div>
                    <div class="member-info">
                        <h4>{{ block.settings.member_name }}</h4>
                        <h5>{{ block.settings.member_proff }}</h5>
                    </div>
                </div>
            {% endfor %}
        </div>

          <button class="team-arrow team-next">❯</button>

</div>

    </div>

</div>

